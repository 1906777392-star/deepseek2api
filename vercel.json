{
  "regions": ["hkg1"],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/openai/:path*" },
    { "source": "/models", "destination": "/api/openai/models" },
    { "source": "/proxy/:path*", "destination": "/api/proxy/:path*" }
  ]
}
